#!/usr/bin/env python3
import sys
import socket
import json
import os

def main():
    if len(sys.argv) < 2:
        print("Usage: rune <command> [args...]")
        print("Commands:")
        print("  run <app_name> [args...]  - Launch a specific application")
        print("  open <file_path>          - Open a file with the appropriate application")
        sys.exit(1)

    socket_path = os.environ.get("RUNE_SOCKET", "/tmp/rune.sock")
    command = sys.argv[1]

    if command == "run":
        if len(sys.argv) < 3:
            print("Usage: rune run <app_name> [args...]")
            sys.exit(1)
        payload = {
            "action": "run",
            "app": sys.argv[2],
            "args": sys.argv[3:]
        }

        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.connect(socket_path)
                s.sendall(json.dumps(payload).encode())
            sys.exit(0)
        except Exception as e:
            print(f"Error connecting to Rune IPC: {e}", file=sys.stderr)
            sys.exit(1)

    elif command == "open":
        if len(sys.argv) != 3:
            print("Usage: rune open <file_path>")
            sys.exit(1)

        file_path = sys.argv[2]
        if not os.path.exists(file_path):
            print(f"Error: File '{file_path}' does not exist.", file=sys.stderr)
            sys.exit(1)

        abs_path = os.path.abspath(file_path)

        payload = {
            "action": "open",
            "path": abs_path
        }

        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.connect(socket_path)
                s.sendall(json.dumps(payload).encode())
            sys.exit(0)
        except Exception as e:
            print(f"Error connecting to Rune IPC: {e}", file=sys.stderr)
            sys.exit(1)
    else:
        print(f"Unknown command: {command}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()